<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NandWatch.App</RootNamespace>
    <AssemblyName>NandWatch</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Unpackaged and self-contained: no MSIX, no certificate, and no
         dependency on whichever Windows App Runtime happens to be installed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Not for MSIX (the app stays unpackaged): without this, `dotnet publish`
         leaves out the app's resources.pri, and the published build dies at
         startup with 0xC000027B (the siblings' trap). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.cs is the entry point: it enforces a single instance. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- There is no XAML in this app: App and MainWindow are built in code like
       every page, so the XAML compiler (a Windows-only program) never runs and
       the app compiles on Linux too, for cloud sessions and CI. Two more
       Windows-only build steps are stood in for off Windows: the manifest
       merge (tools/build/mt-shim.sh) and resource indexing (MakePri), which a
       type-check does not need. A Linux build is a compile check, never a
       build to run. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <ManifestTool>$(MSBuildThisFileDirectory)../../tools/build/mt-shim.sh</ManifestTool>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The components, not the Microsoft.WindowsAppSDK meta-package, which
         also pulls in the AI and ML components (~60 MB) this app never calls. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <!-- The optional tray icon. The core package, as the siblings use: the
         .WinUI one depends on the Windows App SDK meta-package. -->
    <PackageReference Include="H.NotifyIcon" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NandWatch.Windows\NandWatch.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Release output: English UI resources only, and no debug symbols. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <Target Name="DropSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedSymbols)" />
  </Target>
</Project>
