<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Plain net10.0, no Windows APIs: the parsers, the request layout and
         every calculation, so their tests run anywhere. Everything that
         touches Windows is in NandWatch.Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NandWatch.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NandWatch.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
